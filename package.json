{
  "name": "life-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1 --port 3000",
    "build": "bun --bun vite build",
    "start": "bun scripts/serve.ts",
    "typecheck": "bun scripts/generate-routes.ts && bun --bun tsc --noEmit",
    "lint": "bun --bun eslint .",
    "test": "bun test src/tests",
    "db:migrate": "bun scripts/db.ts migrate",
    "db:seed": "bun scripts/db.ts seed"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tanstack/router-generator": "1.167.46",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  }
}
